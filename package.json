{
  "name": "mastarr",
  "version": "14.0.0",
  "private": true,
  "description": "Your private, unified movie and series control room",
  "author": "Mastarr contributors",
  "main": "main.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.mastarr.app",
    "productName": "Mastarr",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "ma1.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png",
      "artifactName": "Mastarr-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mastarr"
    },
    "publish": null
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "prettier": "3.6.2"
  }
}
